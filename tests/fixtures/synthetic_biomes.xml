    <biome name="desert" biomemapcolor="#FFE477" difficulty="3">
      <weather name="default" prob="90"/>
      <weather name="rainlight" prob="5"/>
      <weather name="rainheavy" prob="5"/>
      <weather name="stormbuild" prob="0"/>
      <weather name="storm" prob="0" duration="1.3"/>
