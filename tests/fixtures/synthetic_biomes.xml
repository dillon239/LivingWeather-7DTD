<?xml version="1.0" encoding="UTF-8"?>
<!--
  =====================================================================
  *** SYNTHETIC TEST FIXTURE - NOT VANILLA GAME DATA ***

  Exists ONLY to exercise tools/validate_mod.py logic (well-formedness,
  xpath matching, probability arithmetic, diff scoping) in a schema that
  MIRRORS the verified 3.4.0 shape: root <worldgeneration><biomes>,
  biome weather groups with named entries (default/fog/rainlight/
  rainheavy/stormbuild/storm/bloodMoon/twitch_*) whose prob weights sum
  to 100 per biome, plus the documented duration/delay reference values
  on storm entries. All numbers are INVENTED for testing and must never
  be quoted as vanilla values. For real validation use the actual file
  from your game, or the wiki's version-verified reference copy.
  =====================================================================
-->
<worldgeneration>
  <biomes>
    <biome name="pine_forest" biomemapcolor="#004000" difficulty="1">
      <weather name="default" prob="83" duration="6">
        <Temperature range="76,80"/>
        <CloudThickness range="0,0" prob="35"/>
        <CloudThickness range="10,70" prob="65"/>
        <Precipitation range="0,0"/>
        <Fog range="0,2"/>
        <Wind range="3,22"/>
      </weather>
      <weather name="fog" prob="7">
        <Temperature range="65,70"/>
        <Fog range="17,27"/>
      </weather>
      <weather name="rainlight" prob="6">
        <CloudThickness range="70,90"/>
        <Precipitation range="40,50"/>
        <spectrum name="Rainy"/>
      </weather>
      <weather name="rainheavy" prob="4">
        <CloudThickness range="90,95"/>
        <Precipitation range="70,85"/>
        <spectrum name="Rainy"/>
      </weather>
      <weather name="stormbuild" prob="0" duration=".2">
        <CloudThickness range="98,100"/>
      </weather>
      <weather name="storm" prob="0" duration="1.1" delay="26,36">
        <CloudThickness range="98,100"/>
        <Precipitation range="90,95"/>
        <Wind range="40,40"/>
        <spectrum name="Stormy"/>
      </weather>
      <weather name="bloodMoon" prob="0"/>
      <weather name="twitch_fog" prob="0"/>
      <weather name="twitch_rain" prob="0"/>
      <weather name="twitch_snow" prob="0"/>
      <weather name="twitch_storm" prob="0"/>
    </biome>

    <biome name="burnt_forest" biomemapcolor="#ba00ff" difficulty="2">
      <weather name="default" prob="83"/>
      <weather name="rainlight" prob="10"/>
      <weather name="rainheavy" prob="7"/>
      <weather name="stormbuild" prob="0"/>
      <weather name="storm" prob="0" duration="1.2"/>
      <weather name="bloodMoon" prob="0"/>
      <weather name="twitch_fog" prob="0"/>
      <weather name="twitch_rain" prob="0"/>
      <weather name="twitch_snow" prob="0"/>
      <weather name="twitch_storm" prob="0"/>
