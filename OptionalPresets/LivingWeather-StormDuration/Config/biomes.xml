<?xml version="1.0" encoding="UTF-8"?>
<configs>
<!--
  =====================================================================
  Living Weather v0.1.0 - EXPERIMENTAL Longer Forest Storms addon
  Target: Data/Config/biomes.xml, biome "pine_forest" ONLY.

  The `duration` parameter is documented IN the vanilla file header
  itself (3.4.0 reference): each weather group may carry a duration
  "(in days)(default 3)". Verified vanilla values in pine_forest:
      default duration="6" (present)
      stormbuild duration=".2" (present)
      storm duration="1.1" delay="26,36" (present)
      rainlight / rainheavy: no duration attribute (defaults to 3)

  WHAT CHANGES (use `set` only where the attribute already exists;
  use setattribute only for rainlight/rainheavy, where the duration
  parameter is documented as supported with default 3):
      storm      duration 1.1 -> 1.6   (set; attribute exists)
      rainlight  duration   3 -> 4     (setattribute; documented default 3)
      rainheavy  duration   4          (setattribute; documented default 3)

  delay="26,36" is deliberately NOT touched: its semantics are not
  documented in the file header and will not be guessed.

  Note: duration is in game-days, so in-game minutes depend on your
  DayLightLength/DayLength server settings; the values above extend
  rain/storm groups by ~45% while keeping them far below the vanilla
  default group duration of 6.
  =====================================================================
-->
  <set xpath="//biome[@name='pine_forest']/weather[@name='storm']/@duration">1.6</set>
  <setattribute xpath="//biome[@name='pine_forest']/weather[@name='rainlight']" name="duration">4</setattribute>
  <setattribute xpath="//biome[@name='pine_forest']/weather[@name='rainheavy']" name="duration">4</setattribute>
</configs>
